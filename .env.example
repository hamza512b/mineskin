# Copy the values you need into .env.local (gitignored).

# Capacitor development: point the native WebView at your LAN dev server
# instead of the bundled static export. Must be HTTPS (`npm run dev:host`) —
# the WebView only exposes secure-context APIs over a trusted TLS origin.
# Leave unset for production/bundled builds.
# CAP_SERVER_URL=https://192.168.xx.yy:3000

# ── Release automation (fastlane) — see docs/RELEASING.md ───────────────────
# iOS: App Store Connect API key. App Store Connect -> Users and Access ->
# Integrations -> App Store Connect API -> generate an "App Manager" key,
# download the .p8 ONCE. ASC_KEY is the .p8 file content, base64-encoded to
# one line: base64 -i AuthKey_XXXXXXXXXX.p8
# ASC_KEY_ID=XXXXXXXXXX
# ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ASC_KEY=LS0tLS1CRUdJTiBQUklWQVRFIEtFWS0tLS0tCk1JR1RBZ0VBTUJ...

# Android: Play Developer API service-account JSON key — the full JSON file
# CONTENT on one line, single-quoted (keeps the \n escapes in private_key
# intact). Create it in Google Cloud Console, then invite its email under
# Play Console -> Users and permissions. See docs/RELEASING.md.
# PLAY_JSON_KEY='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}'


# If you want to use Sentry for error tracking, set these values.
# SENTRY_ORG="org-id-here"
# SENTRY_PROJECT="project-id-here"
# NEXT_PUBLIC_SENTRY_DSN="sentry-dsn-here"
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="stripe-publishable-key-here"
# SENTRY_AUTH_TOKEN="sentry-auth-token-here"